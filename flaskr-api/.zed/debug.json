[
    {
        // iTerm2 で debugpy を起動しておき、それに Zed が後から繋ぐ方式。
        // iTerm2 コマンド（SQL_ECHO=1 で実行SQLも同じターミナルに出る）:
        //   SQL_ECHO=1 uv run python -m debugpy --listen 5678 --wait-for-client \
        //     -m flask --app flaskr run --no-reload --port 5001
        "label": "Flask: 起動中サーバーにアタッチ",
        "adapter": "Debugpy",
        "request": "attach",
        "connect": { "host": "127.0.0.1", "port": 5678 }
    },
    {
        // iTerm2 を使わず、Zed 自身に Flask を起動させてデバッグする方式（確実）。
        // サーバーは Zed のデバッグ内で :5001 に立つ。
        // SQL_ECHO=1 なので、実行SQLは Zed のデバッグ用ターミナルに出る。
        // SQLログが邪魔なときは "SQL_ECHO" の行を消す（or "0" にする）。
        "label": "Flask: Zedが起動してデバッグ（SQLログ付き）",
        "adapter": "Debugpy",
        "request": "launch",
        "module": "flask",
        "cwd": "$ZED_WORKTREE_ROOT",
        "env": { "FLASK_APP": "flaskr", "SQL_ECHO": "1" },
        "args": ["run", "--no-reload", "--port", "5001"]
    }
]
