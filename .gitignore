# ===== 秘密情報（絶対にコミットしない） =====
.env
.env.*
!.env.example
*.pem
*.key

# ===== Python / uv =====
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Flask の instance フォルダ（ローカル設定など）
instance/

# ===== Node / React (Vite) =====
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# ===== Docker =====
# ローカル専用の上書き設定は共有しない
docker-compose.override.yml

# ===== エディタ / OS =====
.DS_Store
.vscode/
.idea/
# Zed の設定は個人環境依存なので除外。ただし debug.json は
# docs/00-env.md で教材の一部として配布するため例外にする。
# 注意: `.zed/` とディレクトリごと除外すると `!` で再包含できない。
# `.zed/*`（中身だけ除外）にするのが必須。
**/.zed/*
!**/.zed/debug.json
*.swp
*~

# ===== ログ =====
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===== curl のクッキー保存ファイル（-c/-b で作るセッション jar。ローカル限定） =====
cookie*.txt
*.cookies
alice.txt
bob.txt
